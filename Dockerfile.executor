FROM golang:1.25.14-alpine3.23 AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/tflive-executor ./cmd/executor

FROM alpine:3.21

ARG OPENTOFU_VERSION=1.12.5
ARG TARGETARCH

RUN apk add --no-cache ca-certificates git \
    && wget -O "/tmp/tofu_${OPENTOFU_VERSION}_linux_${TARGETARCH}.tar.gz" \
        "https://github.com/opentofu/opentofu/releases/download/v${OPENTOFU_VERSION}/tofu_${OPENTOFU_VERSION}_linux_${TARGETARCH}.tar.gz" \
    && wget -O "/tmp/tofu_${OPENTOFU_VERSION}_SHA256SUMS" \
        "https://github.com/opentofu/opentofu/releases/download/v${OPENTOFU_VERSION}/tofu_${OPENTOFU_VERSION}_SHA256SUMS" \
    && cd /tmp \
    && grep -F "  tofu_${OPENTOFU_VERSION}_linux_${TARGETARCH}.tar.gz" "tofu_${OPENTOFU_VERSION}_SHA256SUMS" | sha256sum -c - \
    && tar -xzf "tofu_${OPENTOFU_VERSION}_linux_${TARGETARCH}.tar.gz" -C /usr/local/bin tofu \
    && rm -f "tofu_${OPENTOFU_VERSION}_linux_${TARGETARCH}.tar.gz" "tofu_${OPENTOFU_VERSION}_SHA256SUMS" \
    && cd / \
    && addgroup -S tflive \
    && adduser -S -D -H -G tflive tflive \
    && mkdir -p /var/lib/tflive/artifacts /var/lib/tflive/runs /var/lib/tflive/plugin-cache \
    && chown -R tflive:tflive /var/lib/tflive
COPY --from=build /out/tflive-executor /usr/local/bin/tflive-executor

# tofu inherits this from the executor, so every init reuses providers already
# unpacked here. It only skips the download when the template commits a
# .terraform.lock.hcl whose hashes the cached copy matches; without one, tofu
# re-downloads to verify. Do not set TF_PLUGIN_CACHE_MAY_BREAK_DEPENDENCY_LOCK_FILE:
# the cache is shared by every tenant's run and writable by them, and that flag
# makes tofu trust whatever binary is in it.
ENV TF_PLUGIN_CACHE_DIR=/var/lib/tflive/plugin-cache

USER tflive
ENTRYPOINT ["/usr/local/bin/tflive-executor"]
